# Credentials of the application registered at https://developer.allegro.pl
# (application type: device, i.e. "Device flow").
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=

# User-Agent sent with every request: NAME/VERSION (+URL).
# Allegro expects the name of the application you registered.
ALLEGRO_APP_NAME=allegro-mcp-server
ALLEGRO_APP_VERSION=0.1.0
ALLEGRO_APP_URL=https://github.com/

# Optional: where the OAuth token is stored (default ~/.config/allegro-mcp/token.json).
# ALLEGRO_TOKEN_FILE=

# Optional: expose tools that change data on the account (default: off).
# ALLEGRO_ENABLE_WRITE_TOOLS=1

# Optional: use the Allegro sandbox environment instead of production.
# ALLEGRO_SANDBOX=1
